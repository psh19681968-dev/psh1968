{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask: 설교문 생성기 실행",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "python": "${command:python.interpreterPath}",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "1",
                "PORT": "5000"
            },
            "args": [
                "run",
                "--host=0.0.0.0",
                "--port=5000",
                "--no-reload"
            ],
            "envFile": "${workspaceFolder}/.env",
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Python: app.py 직접 실행",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "python": "${command:python.interpreterPath}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "FLASK_DEBUG": "1"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
